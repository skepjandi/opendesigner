# Generated by Cargo
# will have compiled files and executables
debug
target
/target-shared/

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# rustc will dump stack traces when hitting an internal compiler error to PWD
rustc-ice-*.txt

# CMake build trees and generated files (keep CMakePresets.json, ignore your local overrides)
/build/
/build-*/
/cmake-build-*/
/out/
CMakeUserPresets.json
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
Testing/
_deps/
compile_commands.json

# Qt generated files, tooling state and editor project files
.qt/
.qtcreator/
CMakeLists.txt.user*
*.pro.user*
*.autosave
.qmlls.ini
moc_*.cpp
moc_*.h
mocs_compilation*.cpp
qrc_*.cpp
ui_*.h
*_autogen/
*.qmlc
*.jsc
*.qmlcache

# Qt deployment output (macdeployqt, windeployqt, linuxdeploy)
/deploy/
/dist/

# Profiling and benchmark output
flamegraph.svg
perf.data*
*.profraw
*.trace
criterion/
/benches/results/

# Coverage
coverage/
lcov.info
tarpaulin-report.html

# dotenv environment variable files
.env
.env.*
!.env.example

# macOS / editors
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# Agent worktrees (see AGENTS.md)
.worktrees/

# Local tooling caches (FFmpeg fetched by `cargo xtask media-setup`, clangd index)
/.cache/

# Local editor state: projects opened during development, autosaves, history, render caches
*.od.autosave
**/.od/cache/
**/.od/tmp/
/scratch/

# Rendered output and exports produced while developing (reference goldens live in crates/*/tests/golden/)
/exports/
/renders/

# Signing material, notarization credentials and updater keys: NEVER commit
*.p12
*.p8
*.cer
*.pfx
*.pem
*.key
*.keystore
*.provisionprofile
*.mobileprovision
!/docs/**/*.pem

# Packaging output
*.dmg
*.msi
*.AppImage
*.deb
*.rpm
*.app.tar.gz
/release/

# Test output
test-results/
